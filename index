        "El Gini promedio de ingresos en ALC (0,46) casi duplica el de los países desarrollados (0,32)."
      ],
      usoBogota: "El ancla empírica de la tesis central de este informe: la prueba de que la automatización —sin necesidad de IA generativa— ya afectó negativamente a Colombia una vez, con canales de transmisión que el marco de complejidad económica de la Parte I §3 intenta anticipar hacia adelante."
    },
    {
      slug: "wef-future-of-jobs-2025", cat: "marcos", idx: 20,
      title: "Future of Jobs Report 2025",
      authors: "Foro Económico Mundial", org: null,
      date: "2025", doc: null,
      url: "https://www.weforum.org/publications/the-future-of-jobs-report-2025/",
      resumenCorto: "Encuesta a más de 1.000 empleadores globales (55 economías): proyecta 78 millones de empleos netos hacia 2030 y que 39% de las habilidades laborales se transformarán o quedarán obsoletas.",
      resumenExtendido: "El informe insignia del Foro Económico Mundial sobre el futuro del empleo, basado en una encuesta directa a más de 1.000 empleadores globales que en conjunto representan a más de 14 millones de trabajadores en 55 economías. A diferencia de los estudios técnicos de exposición ocupacional, este informe pregunta directamente a quienes toman decisiones de contratación qué esperan que pase con sus plantillas — una medida de expectativa empresarial más que de exposición técnica, y por eso un buen contrapeso a los marcos más técnicos del resto del catálogo.",
      conclusiones: [
        "Los empleadores proyectan la creación de 170 millones de empleos y el desplazamiento de 92 millones hacia 2030 (crecimiento neto de 78 millones, +7% del empleo total).",
        "39% de las habilidades laborales actuales se transformarán o quedarán obsoletas entre 2025 y 2030.",
        "La IA y el análisis de macrodatos encabezan la lista de habilidades de más rápido crecimiento.",
        "Es la encuesta empresarial de mayor escala del catálogo, aunque mide expectativas declaradas, no exposición técnica medida de forma independiente."
      ],
      usoBogota: "Fuente de la cifra más citada del resumen ejecutivo (78 millones de empleos netos, 39% de habilidades transformadas) — marco de referencia global contra el cual contrastar los hallazgos, más modestos en magnitud pero más específicos, de las fuentes colombianas y regionales."
    }
  ];

  var CAT_LABEL = { anclas: "Anclas de discusión pública", voces: "Voces colombianas y latinoamericanas", marcos: "Marcos de exposición ocupacional" };
  var CAT_DESC = {
    anclas: "El debate económico internacional de más alto perfil sobre IA y empleo — el marco frente al cual este informe se posiciona.",
    voces: "Estudios con datos propios de Colombia o de la región — la evidencia que ancla el informe a la realidad de Bogotá.",
    marcos: "Las metodologías que miden qué tan expuesta está una ocupación a la IA — generativa, robótica o de aprendizaje automático."
  };

  var homeEl = document.getElementById('home');
  var listApp = document.getElementById('listApp');
  var detailApp = document.getElementById('detailApp');
  var emptyEl = document.getElementById('empty');
  var backLink = document.getElementById('backLink');
  var search = document.getElementById('search');
  var pills = Array.prototype.slice.call(document.querySelectorAll('.pill'));
  var state = { filter: 'all', query: '' };

  function esc(s){ return (s||'').replace(/[&<>]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c]; }); }

  function renderCard(s){
    return '' +
      '<article class="card" data-cat="'+s.cat+'" data-search="'+esc((s.title+' '+s.authors+' '+(s.org||'')).toLowerCase())+'">' +
        '<div class="card-top"><span class="idx">'+String(s.idx).padStart(2,'0')+'</span><div>' +
          '<h3><a href="#/fuente/'+s.slug+'">'+esc(s.title)+'</a></h3>' +
          '<p class="meta">'+esc(s.authors)+(s.org?' · '+esc(s.org):'')+' · '+esc(s.date)+' · <span class="verified">✓ verificado</span></p>' +
        '</div></div>' +
        '<p class="resumen">'+esc(s.resumenCorto)+'</p>' +
        '<div class="uso"><span class="label">Uso en Bogotá</span><p>'+esc(s.usoBogota)+'</p></div>' +
        '<div class="card-actions">' +
          '<a class="btn primary" href="#/fuente/'+s.slug+'">Ver ficha completa →</a>' +
          '<a class="btn ghost" href="'+s.url+'" target="_blank" rel="noopener">Descargar fuente ↗</a>' +
        '</div>' +
      '</article>';
  }

  function renderList(){
    var q = state.query.trim().toLowerCase();
    var cats = ['anclas','voces','marcos'];
    var html = '';
    var visible = 0;
    cats.forEach(function(cat){
      if(state.filter !== 'all' && state.filter !== cat) return;
      var items = SOURCES.filter(function(s){ return s.cat === cat; });
      var filtered = items.filter(function(s){
        return !q || (s.title+' '+s.authors+' '+(s.org||'')+' '+s.resumenCorto).toLowerCase().indexOf(q) !== -1;
      });
      if(filtered.length === 0) return;
      visible += filtered.length;
      html += '<section class="category" id="'+cat+'"><div class="cat-head"><span class="cat-dot '+cat+'"></span><h2>'+CAT_LABEL[cat]+'</h2></div>';
      html += '<p class="cat-desc">'+CAT_DESC[cat]+'</p>';
      filtered.forEach(function(s){ html += renderCard(s); });
      html += '</section>';
    });
    listApp.innerHTML = html;
    emptyEl.style.display = visible === 0 ? 'block' : 'none';
  }

  function renderDetail(slug){
    var s = SOURCES.filter(function(x){ return x.slug === slug; })[0];
    if(!s){
      detailApp.innerHTML = '<div class="detail"><p>Esta fuente no existe todavía en el catálogo. <a href="#/">Volver.</a></p></div>';
      return;
    }
    var yearMatch = s.date.match(/\d{4}/);
    var cite = esc(s.authors) + '. (' + (yearMatch ? yearMatch[0] : esc(s.date)) + '). <em>' + esc(s.title) + '</em>' +
      (s.doc ? ' (' + esc(s.doc) + ')' : '') + (s.org ? '. ' + esc(s.org) + '.' : '.');
    var conclusiones = s.conclusiones.map(function(c){ return '<li>'+esc(c)+'</li>'; }).join('');
    detailApp.innerHTML =
      '<div class="detail">' +
        '<p class="eyebrow">'+CAT_LABEL[s.cat]+'</p>' +
        '<h1>'+esc(s.title)+'</h1>' +
        '<p class="meta">'+esc(s.authors)+(s.org?' · '+esc(s.org):'')+' · '+esc(s.date)+' · <span class="verified">✓ verificado</span></p>' +
        '<div class="cite-box">'+cite+'</div>' +
        '<h2 class="section-title">Resumen extendido</h2>' +
        '<p>'+esc(s.resumenExtendido)+'</p>' +
        '<h2 class="section-title">Conclusiones clave</h2>' +
        '<ul class="conclusiones">'+conclusiones+'</ul>' +
        '<h2 class="section-title">Uso en el análisis de Bogotá</h2>' +
        '<div class="uso"><p>'+esc(s.usoBogota)+'</p></div>' +
        '<div class="download-row">' +
          '<a class="btn primary" href="'+s.url+'" target="_blank" rel="noopener">Descargar / ver fuente original ↗</a>' +
        '</div>' +
      '</div>';
  }

  function route(){
    var hash = location.hash || '#/';
    var m = hash.match(/^#\/fuente\/([a-z0-9-]+)/);
    if(m){
      homeEl.hidden = true; detailApp.hidden = false; backLink.hidden = false;
      renderDetail(m[1]);
      window.scrollTo(0,0);
    } else {
      homeEl.hidden = false; detailApp.hidden = true; backLink.hidden = true;
      renderList();
    }
  }

  pills.forEach(function(pill){
    pill.addEventListener('click', function(){
      pills.forEach(function(p){ p.setAttribute('aria-pressed','false'); });
      pill.setAttribute('aria-pressed','true');
      state.filter = pill.getAttribute('data-filter');
      renderList();
    });
  });
  search.addEventListener('input', function(){ state.query = search.value; renderList(); });

  window.addEventListener('hashchange', route);
  route();
})();
</script>
